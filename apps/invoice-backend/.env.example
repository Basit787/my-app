# Copy to .env; read by the app (`pnpm dev`). The shared services come from the root docker-compose.yml.

# Verifies the access tokens; the same value as the auth service's JWT_SECRET
JWT_SECRET=dev-secret-change-me

CORS_ORIGIN=http://localhost:3014

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=invoices

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Reads the fields out of PDF/OCR text; a larger model (qwen2.5:7b) is more accurate but needs ~5 GB RAM
OLLAMA_MODEL=qwen2.5:0.5b

# Tesseract languages; each needs its tesseract-ocr-data-<lang> package in the image (SYSTEM_PACKAGES)
OCR_LANGUAGES=eng

# Defaults; uncomment to change
# PORT=3013
# AUTH_URL=http://localhost:3001
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/invoices
# MINIO_ENDPOINT=http://localhost:9000
# REDIS_URL=redis://localhost:6379
# OLLAMA_URL=http://localhost:11434
# MAX_FILE_SIZE_MB=20
# OCR_MAX_PAGES=30
