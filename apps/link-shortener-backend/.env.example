# Copy to .env; read by the app (`pnpm dev`). The shared services come from the root docker-compose.yml.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=link_shortener

# Verifies the access tokens; the same value as the auth service's JWT_SECRET
JWT_SECRET=dev-secret-change-me

CORS_ORIGIN=http://localhost:3004

# Defaults; uncomment to change
# PORT=3012
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/link_shortener
# AUTH_URL=http://localhost:3001
