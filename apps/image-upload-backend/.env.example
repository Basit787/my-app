# Copy to .env; read by the app (`pnpm dev`). The shared services come from the root docker-compose.dev.yml.

# Verifies the access tokens; the same value as the auth service's JWT_SECRET
JWT_SECRET=dev-secret-change-me

CORS_ORIGIN=http://localhost:3005

S3_BUCKET=image-uploads

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Defaults; uncomment to change
# AUTH_URL=http://localhost:3001
# PORT=3006
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/image_upload
# S3_ENDPOINT=https://your-s3-endpoint
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
# S3_REGION=us-east-1
# MAX_FILE_SIZE_MB=10
# REDIS_URL=redis://127.0.0.1:6379
# BIN_RETENTION_DAYS=30
# Cron pattern for the bin purge (hourly)
# BIN_PURGE_CRON=0 * * * *
