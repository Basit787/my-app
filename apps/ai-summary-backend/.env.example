# Copy to .env; read by the app (`pnpm dev`). The shared services come from the root docker-compose.yml.

# Verifies the access tokens; the same value as the auth service's JWT_SECRET
JWT_SECRET=dev-secret-change-me

CORS_ORIGIN=http://localhost:3007

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ai-summaries

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Small model (~1.2 GB RAM) that fits next to the rest of the stack; llama3.2:3b is better but needs ~3.2 GB
OLLAMA_MODEL=qwen2.5:1.5b
# Ollama installed on the Mac uses the GPU (much faster): http://host.docker.internal:11434
# OLLAMA_URL=http://ollama:11434

# Defaults; uncomment to change
# PORT=3008
# AUTH_URL=http://localhost:3001
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/ai_summary
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_REGION=us-east-1
# REDIS_URL=redis://localhost:6379
# OLLAMA_URL=http://localhost:11434
# MAX_FILE_SIZE_MB=1
