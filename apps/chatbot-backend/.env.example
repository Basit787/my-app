# Copy to .env; read by the app (`pnpm dev`). The shared services come from the root docker-compose.yml.

# Verifies the access tokens; the same value as the auth service's JWT_SECRET
JWT_SECRET=dev-secret-change-me

CORS_ORIGIN=http://localhost:3009

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Model served by the ollama container (apps/ai-summary-backend); pulled there by ollama-init
OLLAMA_MODEL=qwen2.5:1.5b
# Ollama installed on the Mac uses the GPU (much faster): http://host.docker.internal:11434
# OLLAMA_URL=http://ollama:11434

# Defaults; uncomment to change
# PORT=3010
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/chatbot
# AUTH_URL=http://localhost:3001
# OLLAMA_URL=http://localhost:11434
