# Copy to .env; read by the app (`pnpm dev`). The shared services come from the root docker-compose.yml.

# Verifies the access tokens; the same value as the auth service's JWT_SECRET
JWT_SECRET=dev-secret-change-me

CORS_ORIGIN=http://localhost:3003,http://localhost:80
# Allow any private-network origin (phones on the same Wi-Fi)
ALLOW_LAN_ORIGINS=true

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=chat-uploads

TURN_USER=chat
TURN_PASSWORD=chatpass
TURN_HOST=localhost
TURN_EXTERNAL_IP=127.0.0.1

# Defaults; uncomment to change
# AUTH_URL=http://localhost:3001
# PORT=3002
# MONGODB_URI=mongodb://127.0.0.1:27018/realtime_chat
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_REGION=us-east-1
# MAX_FILE_SIZE_MB=25
# TURN_PORT=3478
# Origin the mobile app sends (native requests have none)
# MOBILE_APP_ORIGIN=chatwave://
