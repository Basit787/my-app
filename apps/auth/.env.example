# Copy to .env; read by the app (`pnpm dev`). The shared services come from the root docker-compose.yml.

# Signs the access tokens; every backend needs the same value
JWT_SECRET=dev-secret-change-me
# How long a sign-in lasts (seconds)
JWT_TTL_SECONDS=86400
CORS_ORIGIN=http://localhost:3000,http://localhost:3003
# Allow any private-network origin (phones on the same Wi-Fi)
ALLOW_LAN_ORIGINS=true


# Defaults; uncomment to change
# PORT=3001
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/auth
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_BUCKET=auth
